---
import { Image } from "astro:assets";
import { Phone, Menu, X, ChevronDown } from "@lucide/astro";
import Button from "./Button.astro";
import { categories } from "../lib/categories";
import { isBatimatLive } from "../lib/batimat";
import logo from "../assets/images/logo.png";

const nav = [
  { label: "Accueil", href: "/" },
  { label: "Occasion", href: "/echafaudage-doccasion-87/" },
  { label: "Personnalisation", href: "/personnalisation/" },
  { label: "À propos", href: "/a-propos/" },
  { label: "Où nous trouver", href: "/ou-nous-trouver/" },
];

const showBatimat = isBatimatLive();

const phone = "06 09 55 14 94";
const phoneHref = "tel:+33609551494";
---

<header class="sticky top-0 z-50 bg-navy-950 text-white shadow-md shadow-black/10">
  {showBatimat && (
    <a
      href="/salon-batimat-2026/"
      class="block bg-gold-500 px-4 py-1.5 text-center font-heading text-xs font-semibold text-navy-950 hover:bg-gold-600 sm:text-sm"
    >
      Retrouvez-nous au salon Batimat 2026 — 28 sept. au 1er oct., Hall 5.1, Stand F046 →
    </a>
  )}
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-3">
      <Image src={logo} alt="Solution Échafaudages" width={96} height={96} class="h-12 w-12 rounded-md" />
      <span class="whitespace-nowrap font-heading text-lg font-bold leading-tight sm:text-xl">
        Solution<br class="sm:hidden" /> Échafaudages
      </span>
    </a>

    <nav class="hidden items-center gap-5 xl:flex">
      <a
        href="/"
        class="whitespace-nowrap font-heading text-sm font-semibold tracking-wide text-white/85 transition-colors hover:text-gold-400"
      >
        Accueil
      </a>

      <div class="group relative">
        <a
          href="/nos-produits/"
          class="flex items-center gap-1 whitespace-nowrap font-heading text-sm font-semibold tracking-wide text-white/85 transition-colors hover:text-gold-400"
        >
          Nos produits
          <ChevronDown class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" />
        </a>

        <div class="invisible absolute left-1/2 top-full z-10 w-72 -translate-x-1/2 pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="overflow-hidden rounded-lg border border-black/5 bg-white shadow-xl">
            {categories.map((category) => (
              <a
                href={`/types-echaffaudage/${category.slug}/`}
                class="block px-4 py-3 text-sm font-medium text-navy-900 hover:bg-paper hover:text-navy-700"
              >
                {category.title}
              </a>
            ))}
            <a
              href="/tous-les-produits/"
              class="block border-t border-black/5 px-4 py-3 text-sm font-semibold text-navy-600 hover:bg-paper"
            >
              Voir tous les produits
            </a>
          </div>
        </div>
      </div>

      {nav.slice(1).map((item) => (
        <a
          href={item.href}
          class="whitespace-nowrap font-heading text-sm font-semibold tracking-wide text-white/85 transition-colors hover:text-gold-400"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden shrink-0 items-center gap-4 xl:flex">
      <a href={phoneHref} aria-label={`Appeler le ${phone}`} class="flex items-center gap-2 whitespace-nowrap font-heading text-sm font-semibold text-white/90 hover:text-gold-400">
        <Phone class="h-4 w-4 shrink-0" />
        <span class="hidden 2xl:inline">{phone}</span>
      </a>
      <Button href="/contact/" variant="primary" class="whitespace-nowrap">Demander un devis</Button>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex items-center justify-center rounded-md p-2 text-white xl:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Ouvrir le menu"
    >
      <Menu class="h-6 w-6" id="menu-icon-open" />
      <X class="hidden h-6 w-6" id="menu-icon-close" />
    </button>
  </div>

  <nav id="mobile-menu" class="hidden flex-col gap-1 border-t border-white/10 px-4 pb-4 xl:hidden">
    <a href="/" class="rounded-md px-3 py-2 font-heading text-sm font-semibold text-white/85 hover:bg-white/5 hover:text-gold-400">
      Accueil
    </a>

    <div>
      <div class="flex items-center justify-between rounded-md pr-1">
        <a href="/nos-produits/" class="flex-1 rounded-md px-3 py-2 font-heading text-sm font-semibold text-white/85 hover:bg-white/5 hover:text-gold-400">
          Nos produits
        </a>
        <button
          id="products-submenu-toggle"
          type="button"
          class="flex items-center justify-center rounded-md p-2 text-white/70"
          aria-expanded="false"
          aria-controls="products-submenu"
          aria-label="Afficher les catégories de produits"
        >
          <ChevronDown class="h-4 w-4" id="products-submenu-icon" />
        </button>
      </div>
      <div id="products-submenu" class="hidden flex-col gap-1 py-1 pl-4">
        {categories.map((category) => (
          <a
            href={`/types-echaffaudage/${category.slug}/`}
            class="rounded-md px-3 py-2 text-sm text-white/70 hover:bg-white/5 hover:text-gold-400"
          >
            {category.title}
          </a>
        ))}
        <a
          href="/tous-les-produits/"
          class="rounded-md px-3 py-2 text-sm font-semibold text-white/85 hover:bg-white/5 hover:text-gold-400"
        >
          Voir tous les produits
        </a>
      </div>
    </div>

    {nav.slice(1).map((item) => (
      <a
        href={item.href}
        class="rounded-md px-3 py-2 font-heading text-sm font-semibold text-white/85 hover:bg-white/5 hover:text-gold-400"
      >
        {item.label}
      </a>
    ))}
    <a href={phoneHref} class="flex items-center gap-2 rounded-md px-3 py-2 font-heading text-sm font-semibold text-white/85">
      <Phone class="h-4 w-4" />
      {phone}
    </a>
    <Button href="/contact/" variant="primary" class="mt-2 w-full">Demander un devis</Button>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("flex");
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!!isOpen));
  });

  const submenuToggle = document.getElementById("products-submenu-toggle");
  const submenu = document.getElementById("products-submenu");
  const submenuIcon = document.getElementById("products-submenu-icon");

  submenuToggle?.addEventListener("click", () => {
    const isOpen = submenu?.classList.toggle("flex");
    submenu?.classList.toggle("hidden");
    submenuIcon?.classList.toggle("rotate-180");
    submenuToggle.setAttribute("aria-expanded", String(!!isOpen));
  });
</script>
