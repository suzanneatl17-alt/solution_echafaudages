---
import { ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  image: ImageMetadata;
  href: string;
  description?: string;
}

const { title, image, href, description } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-lg border border-black/5 bg-white shadow-sm transition-shadow hover:shadow-lg"
>
  <div class="aspect-square w-full overflow-hidden bg-paper">
    <Image
      src={image}
      alt={title}
      widths={[300, 500]}
      sizes="(min-width: 1024px) 33vw, 50vw"
      class="h-full w-full object-contain p-4 transition-transform duration-200 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col gap-2 border-t border-black/5 p-4">
    <h3 class="font-heading text-base font-bold text-navy-900">{title}</h3>
    {description && <p class="text-sm text-ink/70">{description}</p>}
    <span class="mt-auto flex items-center gap-1 pt-2 font-heading text-sm font-semibold text-navy-600 group-hover:text-gold-600">
      Voir le produit
      <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</a>
