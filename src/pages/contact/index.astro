---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { Phone, Mail, MapPin } from '@lucide/astro';
---

<Layout
	title="Contact — Solution Échafaudages | Devis échafaudage Haute-Vienne"
	description="Contactez Solution Échafaudages pour un devis d'échafaudage neuf ou d'occasion en Haute-Vienne : téléphone, email ou formulaire en ligne."
>
	<PageHero
		eyebrow="Contact"
		title="Nous contacter"
		subtitle="Nous répondons rapidement à toutes vos demandes. N'hésitez pas à nous envoyer un message ou à nous appeler."
	/>

	<section class="reveal mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-5">
		<div class="lg:col-span-2">
			<h2 class="font-heading text-xl font-bold text-navy-900">Nos coordonnées</h2>
			<ul class="mt-6 space-y-4 text-ink/80">
				<li class="flex items-start gap-3">
					<Phone class="mt-1 h-5 w-5 shrink-0 text-gold-600" />
					<a href="tel:+33609551494" class="hover:text-navy-700">06 09 55 14 94</a>
				</li>
				<li class="flex items-start gap-3">
					<Mail class="mt-1 h-5 w-5 shrink-0 text-gold-600" />
					<a href="mailto:solution.echafaudages@gmail.com" class="break-all hover:text-navy-700">
						solution.echafaudages@gmail.com
					</a>
				</li>
				<li class="flex items-start gap-3">
					<MapPin class="mt-1 h-5 w-5 shrink-0 text-gold-600" />
					<span>4 chemin de la petite Chèze, 87590 Saint-Just-le-Martel</span>
				</li>
			</ul>
		</div>

		<form
			id="contact-form"
			class="lg:col-span-3 space-y-5 rounded-lg border border-black/10 bg-white p-6 shadow-sm sm:p-8"
			action="https://api.web3forms.com/submit"
			method="POST"
		>
			<!-- Clé publique Web3Forms (compte solution.echafaudages@gmail.com) : elle peut figurer dans le code. -->
			<input type="hidden" name="access_key" value="79a5c007-3a5f-4abf-b544-09938a3f625d" />
			<input type="hidden" name="from_name" value="Site solutionechafaudages87.fr" />
			<input type="hidden" name="subject" value="Nouvelle demande depuis le site" />
			<input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

			<div class="grid gap-5 sm:grid-cols-2">
				<div>
					<label for="name" class="mb-1 block text-sm font-semibold text-navy-900">Prénom</label>
					<input
						id="name"
						name="name"
						type="text"
						required
						class="w-full rounded-md border border-black/15 px-4 py-2.5 text-sm focus:border-navy-600 focus:outline-none focus:ring-1 focus:ring-navy-600"
					/>
				</div>
				<div>
					<label for="email" class="mb-1 block text-sm font-semibold text-navy-900">Email</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						class="w-full rounded-md border border-black/15 px-4 py-2.5 text-sm focus:border-navy-600 focus:outline-none focus:ring-1 focus:ring-navy-600"
					/>
				</div>
			</div>

			<div class="grid gap-5 sm:grid-cols-2">
				<div>
					<label for="phone" class="mb-1 block text-sm font-semibold text-navy-900">
						Téléphone <span class="font-normal text-ink/50">(facultatif)</span>
					</label>
					<input
						id="phone"
						name="phone"
						type="tel"
						autocomplete="tel"
						class="w-full rounded-md border border-black/15 px-4 py-2.5 text-sm focus:border-navy-600 focus:outline-none focus:ring-1 focus:ring-navy-600"
					/>
				</div>
				<div>
					<label for="subject" class="mb-1 block text-sm font-semibold text-navy-900">Sujet</label>
					<input
						id="subject"
						name="sujet"
						type="text"
						class="w-full rounded-md border border-black/15 px-4 py-2.5 text-sm focus:border-navy-600 focus:outline-none focus:ring-1 focus:ring-navy-600"
					/>
				</div>
			</div>

			<div>
				<label for="message" class="mb-1 block text-sm font-semibold text-navy-900">Message</label>
				<textarea
					id="message"
					name="message"
					rows="5"
					required
					class="w-full rounded-md border border-black/15 px-4 py-2.5 text-sm focus:border-navy-600 focus:outline-none focus:ring-1 focus:ring-navy-600"
				></textarea>
			</div>

			<button
				type="submit"
				class="inline-flex items-center justify-center rounded-md bg-gold-500 px-6 py-3 font-heading text-sm font-semibold text-navy-950 transition-colors hover:bg-gold-600 disabled:cursor-wait disabled:opacity-60"
			>
				Envoyer le message
			</button>

			<p id="form-status" class="hidden rounded-md px-4 py-3 text-sm" role="status" aria-live="polite"></p>
		</form>
	</section>
</Layout>

<script>
	// Envoi en arrière-plan pour rester sur le site (sans JavaScript, le formulaire
	// est posté normalement vers Web3Forms).
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const status = document.getElementById('form-status');
	const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

	function showStatus(message: string, ok: boolean) {
		if (!status) return;
		status.textContent = message;
		status.className = `rounded-md px-4 py-3 text-sm ${ok ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800'}`;
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (button) button.disabled = true;
		try {
			const response = await fetch(form.action, {
				method: 'POST',
				headers: { Accept: 'application/json' },
				body: new FormData(form),
			});
			const result = await response.json();
			if (!response.ok || !result.success) throw new Error(result.message);
			form.reset();
			showStatus('Merci, votre message a bien été envoyé. Nous vous recontactons rapidement.', true);
		} catch {
			showStatus("L'envoi n'a pas abouti. Réessayez ou appelez-nous au 06 09 55 14 94.", false);
		} finally {
			if (button) button.disabled = false;
		}
	});
</script>
