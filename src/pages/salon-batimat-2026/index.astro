---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { CalendarDays, MapPin, Clock, Ticket, Weight, Layers, Milestone } from '@lucide/astro';
import { isBatimatLive } from '../../lib/batimat';
import standBanner from '../../assets/photos/batimat/stand-banner.jpg';
import billetsGratuits from '../../assets/photos/batimat/billets-gratuits.jpg';
import planAcces from '../../assets/photos/batimat/plan-acces.jpg';

if (!isBatimatLive()) {
	return Astro.redirect('/', 301);
}

const billeterieHref = 'https://www.batimat.com/fr-fr/register.html?code=1704283357520653-5V2';

const nouveautes = [
	{
		icon: Weight,
		title: 'Garde-corps MDS Aéro',
		text: "Jusqu'à 20 % de poids en moins, poignées intégrées pour un montage et démontage en sécurité (MDS) plus rapide et moins pénible.",
	},
	{
		icon: Layers,
		title: 'Cadres H',
		text: "La rapidité de montage d'un échafaudage à cadres, avec la modularité d'un système multidirectionnel. Compatibles avec la gamme AFIX FAST X37 existante.",
	},
	{
		icon: Milestone,
		title: 'Limons légers',
		text: "Seulement 16 kg, pour des tours d'accès temporaires et escaliers publics jusqu'à 5 niveaux, avec un assemblage simple et sécurisé.",
	},
];
---

<Layout
	title="Salon Batimat 2026 — Retrouvez AFIX, Hall 5.1 Stand F046 | Solution Échafaudages"
	description="Solution Échafaudages, distributeur AFIX en Haute-Vienne, vous invite au salon Batimat 2026 : 28 septembre au 1er octobre, Paris Expo Porte de Versailles, Hall 5.1 - Stand F046."
>
	<PageHero
		eyebrow="Salon professionnel"
		title="Retrouvez AFIX au salon Batimat 2026"
		subtitle="Solution Échafaudages est distributeur AFIX en Haute-Vienne. Notre partenaire fabricant sera présent au salon Batimat pour présenter ses dernières innovations d'échafaudages — l'occasion de venir échanger avec les experts."
	/>

	<section class="reveal mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div class="overflow-hidden rounded-lg border border-black/5 shadow-sm">
			<Image src={standBanner} alt="AFIX France exposant au salon Batimat 2026" class="w-full" widths={[640, 1024, 1400]} sizes="100vw" />
		</div>

		<div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-3">
			<div class="rounded-lg border border-black/5 bg-paper p-6">
				<CalendarDays class="h-8 w-8 text-gold-600" />
				<h3 class="mt-4 font-heading text-base font-bold text-navy-900">Dates</h3>
				<p class="mt-2 text-sm text-ink/70">Du 28 septembre au 1er octobre 2026</p>
			</div>
			<div class="rounded-lg border border-black/5 bg-paper p-6">
				<Clock class="h-8 w-8 text-gold-600" />
				<h3 class="mt-4 font-heading text-base font-bold text-navy-900">Horaires</h3>
				<p class="mt-2 text-sm text-ink/70">Tous les jours de 9h00 à 19h00</p>
			</div>
			<div class="rounded-lg border border-black/5 bg-paper p-6">
				<MapPin class="h-8 w-8 text-gold-600" />
				<h3 class="mt-4 font-heading text-base font-bold text-navy-900">Lieu</h3>
				<p class="mt-2 text-sm text-ink/70">
					Paris Expo Porte de Versailles<br />
					Hall 5.1 — Stand F046 (AFIX)
				</p>
			</div>
		</div>

		<div class="mt-10 flex flex-col items-center gap-6 rounded-lg bg-navy-950 p-8 text-center sm:p-10">
			<div>
				<h2 class="font-heading text-xl font-bold text-white">Récupérez votre billet gratuit</h2>
				<p class="mx-auto mt-2 max-w-xl text-white/70">
					L'entrée au salon est gratuite sur invitation. Générez votre billet en ligne avant de
					vous déplacer.
				</p>
			</div>
			<a
				href={billeterieHref}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-md bg-gold-500 px-6 py-3 font-heading text-sm font-semibold text-navy-950 transition-colors hover:bg-gold-600"
			>
				<Ticket class="h-4 w-4" />
				Obtenir mon billet gratuit
			</a>
		</div>
	</section>

	<section class="reveal bg-paper py-16">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<h2 class="font-heading text-2xl font-bold text-navy-900">Les nouveautés présentées sur le stand</h2>
			<p class="mt-3 max-w-3xl text-ink/70">
				AFIX dévoilera trois nouvelles solutions AFIX FAST conçues pour améliorer la sécurité,
				l'ergonomie et la productivité sur les chantiers.
			</p>
			<div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
				{nouveautes.map(({ icon: Icon, title, text }) => (
					<div class="rounded-lg border border-black/5 bg-white p-6">
						<Icon class="h-8 w-8 text-gold-600" />
						<h3 class="mt-4 font-heading text-base font-bold text-navy-900">{title}</h3>
						<p class="mt-2 text-sm text-ink/70">{text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="reveal mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<h2 class="font-heading text-2xl font-bold text-navy-900">Comment vous rendre sur le stand</h2>
		<p class="mt-3 max-w-3xl text-ink/70">
			Le stand AFIX France se trouve dans le Hall 5.1, stand F046, à Paris Expo Porte de
			Versailles.
		</p>
		<div class="mt-8 overflow-hidden rounded-lg border border-black/5 shadow-sm">
			<Image src={planAcces} alt="Plan d'accès au salon Batimat 2026, Hall 5.1 Stand F046" class="mx-auto w-full max-w-2xl" widths={[500, 800]} sizes="(min-width: 640px) 672px, 100vw" />
		</div>
	</section>

	<section class="reveal bg-paper py-16">
		<div class="mx-auto max-w-4xl px-4 sm:px-6">
			<div class="overflow-hidden rounded-lg border border-black/5 shadow-sm">
				<Image src={billetsGratuits} alt="Billet gratuit Batimat 2026, offert par AFIX France" class="mx-auto w-full max-w-sm" widths={[400, 700]} sizes="(min-width: 640px) 384px, 80vw" />
			</div>
		</div>
	</section>

	<section class="reveal mx-auto max-w-4xl px-4 py-16 text-center sm:px-6">
		<h2 class="font-heading text-2xl font-bold text-navy-900">Une question sur nos échafaudages AFIX ?</h2>
		<p class="mt-3 text-ink/70">
			En attendant le salon, contactez directement Solution Échafaudages pour vos besoins en
			Haute-Vienne.
		</p>
		<div class="mt-6 flex flex-wrap justify-center gap-4">
			<Button href="/contact/" variant="secondary">Demander un devis</Button>
			<Button href="/nos-produits/" variant="outline-navy">Voir nos produits</Button>
		</div>
	</section>
</Layout>
