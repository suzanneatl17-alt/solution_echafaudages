---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ScaffoldHero from '../components/ScaffoldHero.astro';
import BatimatBanner from '../components/BatimatBanner.astro';
import sunsetPhoto from '../assets/photos/scaffolding-sunset.jpg';
import constructionPhoto from '../assets/photos/domaines/construction.jpg';
import industriePhoto from '../assets/photos/domaines/industrie.png';
import infrastructurePhoto from '../assets/photos/domaines/infrastructure.png';
import evenementPhoto from '../assets/photos/domaines/evenement.jpg';

const domaines = [
  { image: constructionPhoto, title: 'Construction', text: 'Façades, rénovation, maçonnerie, couverture : configuration selon accès et hauteur.' },
  { image: industriePhoto, title: 'Industrie', text: 'Maintenance, interventions techniques : circulation sécurisée et montage efficace.' },
  { image: infrastructurePhoto, title: 'Infrastructures', text: 'Ouvrages, accès spécifiques : solutions ajustées au terrain et aux contraintes de site.' },
  { image: evenementPhoto, title: 'Événements', text: 'Montages temporaires : organisation, sécurité et délais maîtrisés.' },
];

const occasionAtouts = [
  'Coût réduit par rapport au neuf',
  'Matériel professionnel contrôlé',
  'Disponibilité rapide pour vos chantiers',
  'Solution adaptée aux besoins locaux',
];
---

<Layout
	title="Solution Échafaudages — Vente d'échafaudages neufs et d'occasion en Haute-Vienne (87)"
	description="Vente d'échafaudage neuf & d'occasion en Haute-Vienne (87). Livraison en Creuse, Corrèze, Dordogne et Charente. Solutions professionnelles adaptées à votre chantier."
>
	<ScaffoldHero />

	<BatimatBanner />

	<section class="reveal mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<h2 class="font-heading text-2xl font-bold text-navy-900">Domaines d'intervention</h2>
		<p class="mt-3 max-w-3xl text-ink/70">
			Nos solutions s'adaptent aux contraintes terrain, qu'il s'agisse de construction neuve,
			d'industries, d'infrastructures ou d'événementiel. Nous configurons l'échafaudage selon la
			géométrie, les accès, les charges et les exigences de sécurité.
		</p>
		<div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{domaines.map(({ image, title, text }) => (
				<div class="overflow-hidden rounded-lg border border-black/5 bg-white shadow-sm">
					<div class="aspect-[4/3] overflow-hidden">
						<Image
							src={image}
							alt={title}
							class="h-full w-full object-cover"
							widths={[300, 500]}
							quality={65}
							sizes="(min-width: 1024px) 25vw, 50vw"
						/>
					</div>
					<div class="p-6">
						<h3 class="font-heading text-base font-bold text-navy-900">{title}</h3>
						<p class="mt-2 text-sm text-ink/70">{text}</p>
					</div>
				</div>
			))}
		</div>

		<div class="mt-12 rounded-lg bg-navy-950 p-8 text-center text-white sm:p-12">
			<h3 class="font-heading text-xl font-bold sm:text-2xl">Besoin d'une solution adaptée ?</h3>
			<p class="mx-auto mt-3 max-w-xl text-white/75">Donnez vos contraintes, on dimensionne avec vous.</p>
			<div class="mt-6">
				<Button href="/contact/" variant="primary">Demander un devis</Button>
			</div>
		</div>
	</section>

	<section class="reveal bg-paper py-16">
		<div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:items-center">
			<div>
				<p class="mb-2 font-heading text-sm font-semibold uppercase tracking-widest text-navy-600">
					À propos
				</p>
				<h2 class="font-heading text-2xl font-bold text-navy-900">
					Rencontrez votre interlocuteur pour construire des projets sur mesure
				</h2>
				<p class="mt-4 text-ink/70">
					Solutions Échafaudages, basée à Saint-Just-le-Martel et fondée par Éric Frugier, est
					spécialisée dans la vente d'échafaudages neufs et d'occasion pour tous types de
					chantiers, du bâtiment à l'événementiel. Chaque projet est étudié sur mesure, en
					fonction des contraintes du chantier, avec un accompagnement direct, de la prise de
					mesures à la fourniture du matériel adapté.
				</p>
				<div class="mt-6 flex gap-8">
					<div>
						<p class="font-heading text-2xl font-extrabold text-navy-900">25 ans</p>
						<p class="text-sm text-ink/70">d'expertise</p>
					</div>
					<div>
						<p class="font-heading text-2xl font-extrabold text-navy-900">100%</p>
						<p class="text-sm text-ink/70">de clients satisfaits</p>
					</div>
				</div>
				<p class="mt-4 text-sm font-semibold uppercase tracking-wide text-ink/70">
					Éric Frugier — Fondateur & dirigeant
				</p>
				<div class="mt-6">
					<Button href="/a-propos/" variant="outline-navy">Découvrez nos chantiers</Button>
				</div>
			</div>
			<div class="rounded-lg border border-black/10 bg-white p-8 shadow-sm sm:p-10">
				<h3 class="font-heading text-lg font-bold text-navy-900">Sécurité et conformité</h3>
				<p class="mt-3 text-ink/70">
					Chaque échafaudage, neuf ou d'occasion, est vérifié avant livraison pour garantir sa
					conformité et la sécurité de vos équipes sur chantier.
				</p>
			</div>
		</div>
	</section>

	<section class="reveal mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<h2 class="font-heading text-2xl font-bold text-navy-900">
			Vente d'échafaudage d'occasion en Haute-Vienne (87)
		</h2>
		<p class="mt-4 max-w-3xl text-ink/70">
			Spécialiste de la vente d'échafaudage d'occasion en Haute-Vienne (87), nous proposons du
			matériel professionnel contrôlé, robuste et immédiatement disponible. Nos solutions
			s'adressent aux artisans, entreprises du BTP et particuliers exigeants recherchant un
			équipement fiable à prix maîtrisé. Basés en Haute-Vienne, nous intervenons à Limoges ainsi
			que dans les départements limitrophes : Creuse (23), Corrèze (19), Dordogne (24), Charente
			(16) et Indre (36). Livraison possible sur chantier ou retrait sur place selon disponibilité.
		</p>

		<div class="mt-10 grid gap-10 lg:grid-cols-2 lg:items-start">
			<div>
				<h3 class="font-heading text-lg font-bold text-navy-900">Pourquoi choisir un échafaudage d'occasion ?</h3>
				<ul class="mt-4 space-y-3">
					{occasionAtouts.map((title) => (
						<li class="flex items-center gap-3 text-ink/80">
							<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-gold-600"></span>
							{title}
						</li>
					))}
				</ul>
				<h3 class="mt-8 font-heading text-lg font-bold text-navy-900">Un matériel adapté aux professionnels</h3>
				<p class="mt-3 text-ink/70">
					Nos échafaudages d'occasion sont sélectionnés pour leur robustesse et leur conformité
					aux usages professionnels. Ils conviennent aux travaux de façade, rénovation,
					couverture et second œuvre.
				</p>
				<div class="mt-6">
					<Button href="/echafaudage-doccasion-87/" variant="secondary">Voir l'offre locale</Button>
				</div>
			</div>
			<div class="rounded-lg border border-black/5 bg-paper p-8 sm:p-10">
				<p class="font-heading text-lg font-bold text-navy-900">Demandez votre devis en Haute-Vienne</p>
				<p class="mt-2 text-sm text-ink/70">
					Besoin d'un échafaudage d'occasion à Limoges ou en Haute-Vienne ? Contactez-nous pour un
					devis rapide et personnalisé.
				</p>
				<div class="mt-4">
					<Button href="/contact/" variant="outline-navy" class="w-full sm:w-auto">
						Nous contacter
					</Button>
				</div>
			</div>
		</div>
	</section>

	<section class="reveal relative overflow-hidden text-white">
		<Image
			src={sunsetPhoto}
			alt=""
			class="absolute inset-0 h-full w-full object-cover"
			widths={[640, 1024, 1600]}
			sizes="100vw"
		/>
		<div class="absolute inset-0 bg-navy-950/85"></div>
		<div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6">
			<h2 class="font-heading text-2xl font-bold sm:text-3xl">Besoin d'un devis rapide ?</h2>
			<p class="mx-auto mt-3 max-w-xl text-white/75">
				Appelez-nous directement ou laissez-nous un message, nous revenons vers vous rapidement.
			</p>
			<div class="mt-8 flex flex-wrap justify-center gap-4">
				<Button href="/contact/" variant="primary">Accéder au formulaire</Button>
				<Button href="tel:+33609551494" variant="ghost">06 09 55 14 94</Button>
			</div>
		</div>
	</section>
</Layout>
