---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { categories } from '../../lib/categories';
import {
  Columns3,
  ShieldHalf,
  LayoutGrid,
  Milestone,
  Footprints,
  CircleDot,
  Building,
} from '@lucide/astro';

const icons: Record<string, typeof Columns3> = {
  'montant-dechafaudage': Columns3,
  'garde-corps-mds': ShieldHalf,
  'diagonale-dechafaudage': Milestone,
  planchers: LayoutGrid,
  'acces-circulation': Footprints,
  'embases-et-socles': CircleDot,
  'echafaudage-facade': Building,
};
---

<Layout
	title="Nos produits — Échafaudages et accessoires | Solution Échafaudages"
	description="Montants, garde-corps, planchers, diagonales et accessoires d'échafaudage AFIXFAST, neufs et d'occasion, disponibles en Haute-Vienne."
>
	<PageHero
		eyebrow="Nos produits"
		title="Tous les composants pour équiper votre chantier"
		subtitle="Matériel neuf et d'occasion, système AFIXFAST, contrôlé avant livraison."
	/>

	<section class="reveal mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{categories.map((category) => {
				const Icon = icons[category.slug];
				return (
					<a
						href={`/types-echaffaudage/${category.slug}/`}
						class="rounded-lg border border-black/5 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
					>
						<Icon class="h-8 w-8 text-gold-600" />
						<h3 class="mt-4 font-heading text-base font-bold text-navy-900">{category.title}</h3>
						<p class="mt-2 text-sm text-ink/70">{category.description}</p>
					</a>
				);
			})}
		</div>

		<div class="mt-10 text-center">
			<Button href="/tous-les-produits/" variant="outline-navy">Voir tous les produits</Button>
		</div>

		<div class="mt-12 rounded-lg bg-navy-950 p-8 text-center text-white sm:p-12">
			<h2 class="font-heading text-xl font-bold sm:text-2xl">Besoin d'un composant précis ?</h2>
			<p class="mx-auto mt-3 max-w-xl text-white/75">
				Décrivez-nous votre chantier et vos besoins, nous vous proposons la configuration adaptée
				— en neuf ou en occasion.
			</p>
			<div class="mt-6">
				<Button href="/contact/" variant="primary">Demander un devis</Button>
			</div>
		</div>
	</section>
</Layout>
