---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import Button from '../../../components/Button.astro';
import SpecTable from '../../../components/SpecTable.astro';
import { getCategory } from '../../../lib/categories';
import { CheckCircle2 } from '@lucide/astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { title, excerpt, description, image, specs, table, variants, category } = product.data;
const cat = getCategory(category);
---

<Layout
	title={`${title} — Solution Échafaudages`}
	description={excerpt}
	image={image.src}
>
	<PageHero eyebrow={cat?.title} title={title} subtitle={excerpt} />

	<section class="reveal mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div class="grid gap-12 lg:grid-cols-2 lg:items-start">
			<div class="overflow-hidden rounded-lg border border-black/5 bg-paper">
				<Image src={image} alt={title} class="h-full w-full object-contain p-6" widths={[400, 700]} sizes="(min-width: 1024px) 50vw, 100vw" />
			</div>

			<div>
				<p class="text-ink/80 leading-relaxed">{description}</p>

				{specs && specs.length > 0 && (
					<ul class="mt-6 space-y-3">
						{specs.map((spec) => (
							<li class="flex items-start gap-3 text-sm text-ink/80">
								<CheckCircle2 class="mt-0.5 h-5 w-5 shrink-0 text-gold-600" />
								<span>{spec}</span>
							</li>
						))}
					</ul>
				)}

				<div class="mt-8 flex flex-wrap gap-4">
					<Button href="/contact/" variant="secondary">Demander un devis</Button>
					{cat && <Button href={`/types-echaffaudage/${cat.slug}/`} variant="outline-navy">Voir la catégorie</Button>}
				</div>
			</div>
		</div>

		{table && (
			<div class="mt-12">
				<h2 class="font-heading text-lg font-bold text-navy-900">Tailles et références</h2>
				<div class="mt-4">
					<SpecTable headers={table.headers} rows={table.rows} />
				</div>
			</div>
		)}

		{variants && variants.length > 0 && (
			<div class="mt-16 space-y-10">
				<h2 class="font-heading text-2xl font-bold text-navy-900">Variantes et références</h2>
				{variants.map((variant) => (
					<div class="grid min-w-0 gap-6 border-t border-black/10 pt-8 lg:grid-cols-[220px_1fr]">
						<div class="aspect-square w-full overflow-hidden rounded-lg border border-black/5 bg-paper lg:w-[220px]">
							<Image src={variant.image} alt={variant.name} class="h-full w-full object-contain p-4" widths={[220, 400]} sizes="220px" />
						</div>
						<div class="min-w-0">
							<h3 class="font-heading text-base font-bold text-navy-900">{variant.name}</h3>
							{variant.description && <p class="mt-2 text-sm text-ink/70">{variant.description}</p>}
							{variant.specs && (
								<ul class="mt-3 space-y-1 text-sm text-ink/70">
									{variant.specs.map((s) => (
										<li class="flex items-start gap-2">
											<CheckCircle2 class="mt-0.5 h-4 w-4 shrink-0 text-gold-600" />
											<span>{s}</span>
										</li>
									))}
								</ul>
							)}
							{variant.table && (
								<div class="mt-4">
									<SpecTable headers={variant.table.headers} rows={variant.table.rows} note={variant.note} />
								</div>
							)}
						</div>
					</div>
				))}
			</div>
		)}
	</section>
</Layout>
